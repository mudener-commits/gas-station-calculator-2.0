.home{padding-top:50rpx}.brand{display:flex;gap:22rpx;align-items:center;margin-bottom:56rpx}.brand image{width:80rpx;height:80rpx;flex-shrink:0;border-radius:18rpx}.intro{font-size:36rpx;font-weight:700;margin:30rpx 0}.entry{background:#fff;border:1rpx solid #cddfeb;border-radius:24rpx;margin-bottom:28rpx;padding:34rpx}.eyebrow{font-size:23rpx;color:#527c9d;letter-spacing:2rpx}.entry-title{font-size:40rpx;font-weight:800;color:#004b8d;margin:20rpx 0}.entry-title text{float:right}.entry-copy{font-size:28rpx;line-height:1.9;color:#425a6f}.entry-bottom{border-top:1rpx solid #e3edf5;margin-top:28rpx;padding-top:20rpx;font-size:23rpx;color:#527c9d}.footer{text-align:center;color:#74899a;font-size:23rpx;line-height:2;margin-top:40rpx}

/* Keep each phrase intact so brackets, separators and commas never start a line. */
.brand-copy{flex:1;min-width:0}.brand .title{display:flex;flex-wrap:wrap;column-gap:0;line-height:1.45}.title-part{display:inline-block;white-space:nowrap}.brand .brand-subtitle{display:flex;flex-wrap:wrap;column-gap:8rpx;overflow-wrap:normal;word-break:normal;line-height:1.8;margin-top:6rpx}.subtitle-part{display:inline-block;white-space:nowrap}
