<view class="page report-page"><block wx:if="{{report}}"><view class="brand-header"><image src="{{brand.appLogo}}" mode="aspectFit"/><view><view class="brand-name">{{brand.appName}}</view><view class="muted">免费测算 · 本地计算，数据安全</view></view></view><view class="title">{{report.title}}</view><view class="report-name">{{report.name}}</view><view class="muted">测算时间：{{report.time}}</view><view class="card"><view class="metric" wx:for="{{report.metrics}}" wx:key="label"><view class="metric-label">{{item.label}}</view><view class="metric-value {{report.type === 'break-even' ? 'break-even-metric' : ''}}">{{item.value}}</view><text class="link" data-term="{{item.term}}" bindtap="explain">查看说明</text></view></view>
<view class="card share-panel" id="brief-preview"><view class="section-title">简要版图片分享</view><view class="muted">突出核心结果与方案概览，适合快速交流，不包含完整费用明细及逐年表格。</view><button class="btn" bindtap="generate" data-kind="brief" disabled="{{exporting}}">{{exportingKind === 'brief' ? '正在生成简要图片…' : briefImage ? '重新生成简要图片' : '生成简要分享图片'}}</button><block wx:if="{{briefImage}}"><view class="actions"><button class="btn secondary" bindtap="save" data-kind="brief">保存简要图片</button><button class="btn" bindtap="shareImage" data-kind="brief">分享简要图片</button></view><image src="{{briefImage}}" mode="widthFix" class="report-image" bindtap="preview" data-kind="brief"/></block></view>
<view class="card share-panel" id="full-preview"><view class="section-title">完整版长图分享</view><view class="muted">{{report.type === 'break-even' ? '保留两种平衡销量、完整测算条件、油气费用及逐年修正。' : '保留全部明细与投资逐年表格，口径及术语说明与简要版一致。'}}一张完整长图，上下查看，点击可放大。</view><button class="btn secondary" bindtap="generate" data-kind="full" disabled="{{exporting}}">{{exportingKind === 'full' ? '正在生成完整版长图…' : images.length ? '重新生成完整版长图' : '生成完整版分享长图'}}</button><block wx:if="{{images.length}}"><view class="actions"><button class="btn secondary" bindtap="save" data-kind="full">保存完整版长图</button><button class="btn" bindtap="shareImage" data-kind="full">分享完整版长图</button></view><image src="{{images[0]}}" mode="widthFix" class="report-image" bindtap="preview" data-kind="full"/></block></view>
<view class="card" wx:for="{{report.sections}}" wx:key="title"><view class="section-title">{{item.title}}</view><view class="row {{line.unitCost ? 'unit-cost-row' : ''}}" wx:for="{{item.rows}}" wx:for-item="line" wx:key="label"><text class="label">{{line.label}}</text><view wx:if="{{line.unitCost}}" class="value unit-cost-value"><text class="unit-cost-primary">{{line.primaryValue}}</text><text wx:if="{{line.secondaryValue}}" class="unit-cost-secondary">{{line.secondaryValue}}</text></view><text wx:else class="value {{line.highlight ? 'highlight' : ''}}">{{line.value}}</text></view></view>
<view class="card" wx:if="{{report.annualTable}}"><view class="section-title">{{report.annualTable.title}}</view><view class="muted">{{report.annualTable.unit}} · 左右滑动查看全部列</view><scroll-view scroll-x class="annual-scroll"><view class="annual-table"><view class="annual-row annual-heading"><text wx:for="{{report.annualTable.columns}}" wx:key="key">{{item.label}}</text></view><view class="annual-row" wx:for="{{report.annualTable.rows}}" wx:key="year"><text wx:for="{{item.cells}}" wx:for-item="cell" wx:key="key" class="{{cell.highlight ? 'highlight' : ''}}">{{cell.value}}</text></view></view></scroll-view><view class="muted annual-note">{{report.annualTable.note}}</view></view>
<view class="card"><view class="section-title">测算口径</view><view class="note" wx:for="{{report.notes}}" wx:key="*this">{{item}}</view></view><view class="card"><view class="section-title">本报告术语说明</view><view class="term" wx:for="{{report.terms}}" wx:key="id"><view class="term-title">{{item.title}}</view><view class="muted">{{item.text}}</view></view></view>
<view class="brand-footer"><image src="{{brand.accountLogo}}" mode="aspectFit"/><view><view class="brand-line"><view class="brand-name">公众号 · {{brand.accountName}}</view><view class="brand-slogan">{{brand.slogan}}</view></view><view class="muted brand-welcome">{{brand.welcome}}</view></view></view><canvas type="2d" id="reportCanvas" class="report-canvas"/></block><view class="card" wx:else>尚无报告，请先完成一次利润、投资回报或盈亏平衡销量测算。</view></view>
