.report-page{background:#fff}.report-page .title{margin-top:32rpx}.report-page .card{border-radius:12rpx;border-color:#e2ebf1}.report-name{font-size:31rpx;font-weight:700;margin:20rpx 0;word-break:break-all}.term{margin-top:25rpx}.term-title{font-weight:700;font-size:27rpx}.report-image{display:block;width:100%;height:auto;margin-top:25rpx}.brand-header,.brand-footer{display:flex;align-items:center;gap:20rpx;padding:10rpx 0 28rpx;border-bottom:1rpx solid #d8e6f0}.brand-header image,.brand-footer image{width:88rpx;height:88rpx;flex-shrink:0;border-radius:16rpx}.brand-header>view,.brand-footer>view{min-width:0;flex:1}.brand-name{font-size:26rpx;font-weight:700;color:#004b8d}.brand-footer{margin-top:32rpx;padding-top:32rpx;border-top:1rpx solid #d8e6f0;border-bottom:0;align-items:flex-start}.brand-slogan{font-size:28rpx;font-weight:700;color:#004b8d;margin:8rpx 0}
.annual-scroll{width:100%;margin-top:20rpx}.annual-table{width:1030rpx;font-size:26rpx;font-variant-numeric:tabular-nums}.annual-row{display:grid;grid-template-columns:80rpx repeat(5,190rpx);border-bottom:1rpx solid #d9e6f0}.annual-row text{padding:20rpx 12rpx;text-align:right;min-width:0;overflow-wrap:anywhere;border-right:1rpx solid #e4ecf3}.annual-row text:first-child{text-align:center}.annual-row:nth-child(odd){background:#f8fafc}.annual-heading,.annual-row.annual-heading{background:#edf5fb;color:#004b8d;font-weight:700}.annual-heading text{white-space:pre-line;text-align:center}.annual-note{margin-top:18rpx}
.row.unit-cost-row{align-items:flex-start}.row .unit-cost-value{flex:0 1 auto;display:flex;flex-direction:column;align-items:flex-end;gap:2rpx;word-break:normal}.unit-cost-primary{color:#c93643;font-weight:750;font-size:28rpx;white-space:nowrap}.unit-cost-secondary{color:#b85860;font-size:23rpx;white-space:nowrap}.brand-line{display:flex;align-items:center;gap:16rpx;min-width:0}.brand-line .brand-name{font-size:24rpx;white-space:nowrap;flex-shrink:0}.brand-line .brand-slogan{margin:0;padding-left:16rpx;border-left:2rpx solid #b5cedf;font-size:24rpx;line-height:1.6;font-family:"Songti SC","STSong",serif;font-weight:600;letter-spacing:.3rpx;white-space:nowrap;color:#28658b}.brand-welcome{margin-top:14rpx;white-space:pre-line}

.break-even-metric{white-space:pre-line;font-size:32rpx;line-height:1.9}
.report-page .row .label{white-space:pre-line}
