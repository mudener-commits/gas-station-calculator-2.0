<template name="fields"><view class="grid"><view class="field" wx:for="{{items}}" wx:key="key"><text>{{item.label}}</text><input type="{{item.signed ? 'text' : 'digit'}}" value="{{form[item.key]}}" data-key="{{item.key}}" bindinput="input" /></view></view></template>
<view class="page">
  <view class="title">利润计算器</view><view class="muted">先看日常经营能赚多少 · 本地计算，数据安全</view>
  <view class="actions"><button class="btn secondary" bindtap="sample">填入示例</button><button class="btn secondary" bindtap="reset">清空填写</button></view>
  <view class="card"><view class="field"><text>站点名称（选填）</text><input value="{{stationName}}" maxlength="40" bindinput="nameInput" placeholder="例如：城南站" /></view><view class="section-title">销量 · 日均</view><template is="fields" data="{{items: dailyFields, form}}"/><view class="switch-row"><text>包含 LNG（液化天然气）业务</text><switch checked="{{form.hasLng}}" data-key="hasLng" bindchange="switchField" color="#0072bc"/></view><view class="field" wx:if="{{form.hasLng}}"><text>液化天然气销量（公斤/天）</text><input type="digit" value="{{form.volLng}}" data-key="volLng" bindinput="input"/></view></view>
  <view class="card"><view class="section-title">油气价格与毛利</view><radio-group class="options" bindchange="priceMode"><label class="option {{priceIndex === index ? 'checked' : ''}}" wx:for="{{priceOptions}}" wx:key="*this"><radio value="{{index}}" checked="{{priceIndex === index}}" color="#0068ad"/><text>{{item}}</text></label></radio-group>
    <view class="note">直接填写带票的含税采购价、含税销售价。经营税费由程序测算，无需自己计算。</view>
    <view class="note" wx:if="{{priceConversionNote}}">{{priceConversionNote}}</view>
    <view class="note" wx:if="{{priceIndex === 0}}">参考毛利为含税售价与含税采购价之差：92# 1 元/升，95# 1.3 元/升，柴油 0.3 元/升，液化天然气 0.5 元/公斤。请按实际经营调整。</view>
    <view class="note" wx:if="{{priceIndex === 1}}">此处毛利填写含税售价减含税采购价的差额，并非已扣增值税的利润。毛利模式按参考采购价推算，精确测算请填写实际采购价 / 售价。</view>
    <block wx:if="{{priceIndex === 1}}"><template is="fields" data="{{items: marginFields, form}}"/><view class="field" wx:if="{{form.hasLng}}"><text>液化天然气毛利（元/公斤）</text><input type="text" data-key="marginLng" value="{{form.marginLng}}" bindinput="input"/></view></block>
    <block wx:if="{{priceIndex === 2}}"><view class="section-title">实际采购价 / 售价 · 含税、带票</view><template is="fields" data="{{items: priceFields, form}}"/><view wx:if="{{form.hasLng}}" class="grid"><view class="field"><text>液化天然气采购价（元/吨）</text><input type="digit" data-key="purchaseLng" value="{{form.purchaseLng}}" bindinput="input"/></view><view class="field"><text>液化天然气售价（元/吨）</text><input type="digit" data-key="saleLng" value="{{form.saleLng}}" bindinput="input"/></view></view></block>
  </view>
  <view class="card"><view class="section-title">人员工资 · 元/月</view><radio-group class="options" bindchange="wageMode"><label class="option {{wageIndex === index ? 'checked' : ''}}" wx:for="{{wageOptions}}" wx:key="*this"><radio value="{{index}}" checked="{{wageIndex === index}}" color="#0068ad"/><text>{{item}}</text></label></radio-group><view wx:if="{{wageIndex === 0}}" class="grid"><view class="field"><text>普通员工人数</text><input type="number" data-key="employeeCount" value="{{form.employeeCount}}" bindinput="input"/></view><view class="field"><text>普通员工人均月薪</text><input type="digit" data-key="avgSalary" value="{{form.avgSalary}}" bindinput="input"/></view></view><view wx:else class="field"><text>普通员工月薪总额</text><input type="digit" data-key="salaryTotal" value="{{form.salaryTotal}}" bindinput="input"/></view><view class="field"><text>站长月薪</text><input type="digit" data-key="stationSalary" value="{{form.stationSalary}}" bindinput="input"/></view><view class="switch-row"><text>缴纳社保（按工资 32% 估算）</text><switch checked="{{form.hasSocial}}" data-key="hasSocial" bindchange="switchField" color="#0072bc"/></view></view>
  <view class="card" wx:for="{{costGroups}}" wx:key="title"><view class="section-title">{{item.title}}</view><template is="fields" data="{{items: item.fields, form}}"/><view class="field" wx:if="{{item.title === '共同费用分摊' && form.hasLng}}"><text>LNG（液化天然气）分摊系数</text><input type="digit" data-key="lngCostWeight" value="{{form.lngCostWeight}}" bindinput="input"/></view></view>
  <view class="card"><view class="section-title">日常合规与附加税费</view><view class="switch-row"><text>计入证照支出</text><switch checked="{{form.hasLicense}}" data-key="hasLicense" bindchange="switchField" color="#0072bc"/></view><view class="grid"><view class="field" wx:if="{{form.hasLicense}}"><text>证照费用（元/年）</text><input type="digit" data-key="licenseCost" value="{{form.licenseCost}}" bindinput="input"/></view><view class="field"><text>其他行政合规（元/年）</text><input type="digit" data-key="adminCost" value="{{form.adminCost}}" bindinput="input"/></view></view><view class="field"><text>城建税所在地</text><radio-group class="options" bindchange="cityMode"><label class="option {{cityIndex === index ? 'checked' : ''}}" wx:for="{{cityOptions}}" wx:key="*this"><radio value="{{index}}" checked="{{cityIndex === index}}" color="#0068ad"/><text>{{item}}</text></label></radio-group></view><view class="note">租金、折旧、融资、合作费用与企业所得税，在投资回报计算器中填写与计算。</view></view>
  <view class="actions"><button class="btn" data-period="month" bindtap="calculate">按月度计算</button><button class="btn" data-period="year" bindtap="calculate">按年度计算</button></view>
  <view class="muted">月度为年化经营结果 ÷ 12 的平均月测算。</view>
  <view class="card" wx:if="{{result}}" id="result"><view class="metric" wx:for="{{report.metrics}}" wx:key="term"><view class="metric-label">{{item.label}}</view><view class="metric-value">{{item.value}}</view><text class="link" data-term="{{item.term}}" bindtap="explain">查看说明</text></view><view class="warning" wx:for="{{result.warnings}}" wx:key="*this">{{item}}</view><button class="btn" bindtap="report">点击查看完整版经营测算报告</button><button class="btn secondary" bindtap="invest">用这份数据测算投资回报</button><button class="btn secondary" bindtap="saveHistory" disabled="{{!!savedId}}">{{savedId ? '本次填写数据已保存' : '保存填写数据到历史报告'}}</button></view>
  <view class="card"><view class="section-title">历史报告数据（本地存储）</view><view class="muted">最多保留 100 份，仅保存填写数据。旧记录按 2.0 经营口径重新测算。</view><view wx:if="{{!history.length}}" class="note">尚无已保存报告，完成一次测算后可保存。</view><view class="history-item" wx:for="{{history}}" wx:key="id"><view class="history-name">{{item.stationName || '未命名站点'}}</view><view class="muted">{{item.periodLabel}} · {{item.date}}</view><view class="history-number">经营 EBITDA（息税折旧摊销前利润） {{item.value}}</view><view><text class="pill" wx:for="{{item.volumes}}" wx:for-item="vol" wx:key="*this">{{vol}}</text></view><view class="actions"><button class="btn secondary" bindtap="restore" data-id="{{item.id}}">恢复填写</button><button class="btn danger" bindtap="remove" data-id="{{item.id}}">删除</button></view></view><button class="btn danger" wx:if="{{history.length}}" bindtap="clearHistory">清空全部历史报告</button></view>
  <button class="btn secondary" bindtap="guide">测算口径与财务概念说明</button>
  <view class="card"><view class="section-title">我的默认数据</view><view class="muted">保存常用价格与费用，填入时不覆盖当前销量。</view><view class="actions"><button class="btn secondary" bindtap="saveDefaults">保存默认数据</button><button class="btn secondary" bindtap="applyDefaults">填入默认数据</button></view><button class="btn secondary" bindtap="clearDefaults">清除我的默认数据</button></view>
</view>
