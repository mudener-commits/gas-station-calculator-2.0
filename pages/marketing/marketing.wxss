.marketing-page .title{margin-bottom:8rpx}
.marketing-tabs{margin:24rpx 0 4rpx}
.marketing-tabs .btn{margin:0;padding:13rpx 7rpx;min-height:82rpx;font-size:24rpx}
.marketing-tabs .active{background:#0068ad;color:#fff}
.marketing-product{border-top:1rpx solid #e2ebf2;padding:24rpx 0 10rpx}
.marketing-product:first-of-type{margin-top:16rpx}
.marketing-product-head{display:flex;justify-content:space-between;align-items:baseline;gap:12rpx;margin-bottom:14rpx}
.marketing-product-head text:first-child{font-size:29rpx;font-weight:750;color:#174362}
.marketing-product-head text:last-child{font-size:22rpx;color:#7891a3}
.marketing-product .field text{min-height:42rpx}
.advanced-button{margin:8rpx 0 0}
.marketing-result{border-color:#b9d6e7;box-shadow:0 8rpx 22rpx rgba(0,75,141,.06)}
.marketing-main{display:flex;align-items:baseline;flex-wrap:wrap;gap:12rpx;color:#004b8d;margin:8rpx 0}
.marketing-main text:first-child{font-size:57rpx;font-weight:800;line-height:1.35}
.marketing-main text:last-child{font-size:26rpx;font-weight:700}
.marketing-lng{font-size:30rpx;font-weight:700;color:#004b8d}
.marketing-difference{font-size:28rpx;line-height:1.6;font-weight:700;color:#c34e42;margin-top:8rpx}
.marketing-pills{display:flex;flex-wrap:wrap;gap:10rpx;margin-top:22rpx}
.marketing-pills text{background:#edf6fb;color:#466d87;padding:8rpx 14rpx;border-radius:40rpx;font-size:22rpx}
.marketing-legend{display:flex;flex-wrap:wrap;gap:18rpx;font-size:22rpx;margin:20rpx 0 10rpx}
.marketing-legend .original{color:#d84b50}.marketing-legend .campaign{color:#0878b7}.marketing-legend .forecast{color:#f0a034}
.marketing-chart{display:block;width:100%;height:405rpx;background:#fcfeff;border:1rpx solid #e4edf3;border-radius:12rpx}
.marketing-axis{text-align:center;margin-top:6rpx}
.marketing-forecast{background:#f5fafc;border:1rpx solid #dce9f1;border-radius:14rpx;padding:22rpx;margin-top:20rpx}
.marketing-preview-title{font-size:25rpx;color:#49677e}.marketing-preview-volume{font-size:28rpx;color:#004b8d;font-weight:750;margin:5rpx 0 10rpx;overflow-wrap:anywhere}
.marketing-drag{font-size:22rpx;color:#497896;font-weight:700;margin:0 0 12rpx}
.marketing-impact{font-size:28rpx;font-weight:750;color:#bd4c40;margin:8rpx 0}
.marketing-impact.positive{color:#10866a}
.marketing-share{margin-top:18rpx;border-top:1rpx solid #e5eef4;padding-top:10rpx}
.marketing-report-image{width:100%;margin-top:22rpx;border:1rpx solid #e0eaf1;border-radius:12rpx}
.marketing-report-canvas{position:fixed;left:-3000px;top:0;width:750px;height:1800px;pointer-events:none}
@media(max-width:360px){.marketing-tabs .btn{font-size:22rpx}.marketing-main text:first-child{font-size:48rpx}.marketing-chart{height:370rpx}}
