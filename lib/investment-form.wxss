.asset{padding-top:20rpx;border-bottom:1rpx solid #e0ebf3;margin-bottom:20rpx}.asset>view:first-child{font-weight:700;margin-bottom:16rpx}.growth-head,.growth-row{display:grid;grid-template-columns:100rpx 1fr 1fr;gap:16rpx;align-items:center;margin-top:16rpx;font-size:24rpx}.growth-head{color:#61798e}.growth-row input{width:100%;height:76rpx;border:1rpx solid #cbdfea;border-radius:10rpx;padding:0 12rpx}.growth-row>text:last-child{text-align:right;color:#00558f;overflow-wrap:anywhere}.growth-head,.growth-row{grid-template-columns:88rpx minmax(180rpx,1fr) minmax(0,1fr);gap:12rpx}.growth-control{display:flex;min-width:0;align-items:stretch}.growth-control input{min-width:0;border-radius:10rpx 0 0 10rpx;height:92rpx}.step-buttons{display:flex;flex-direction:column;flex-shrink:0}.step-buttons button{margin:0;width:66rpx;height:46rpx;min-height:0;padding:0;line-height:46rpx;background:#edf6fc;color:#0068ad;font-size:20rpx;border:1rpx solid #cbdfea;border-radius:0}.step-buttons button:first-child{border-radius:0 10rpx 0 0}.step-buttons button:last-child{border-radius:0 0 10rpx 0}.growth-input-wrap{position:relative;flex:1;min-width:0}.growth-control .growth-input-wrap input{width:100%;padding-right:38rpx}.growth-percent{position:absolute;right:12rpx;top:0;height:92rpx;line-height:92rpx;color:#63798d;font-size:25rpx;pointer-events:none}

.forecast-settings{grid-template-columns:minmax(0,1fr)}.forecast-settings .field>text{line-height:1.65}.forecast-settings .field .label-unit{display:inline;white-space:nowrap;margin:0;font-size:inherit}.growth-settings-note{margin-top:20rpx}.growth-actions{margin-bottom:24rpx}.growth-actions .btn{font-size:25rpx}

