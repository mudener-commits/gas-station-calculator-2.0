page{background:#f4f8fb;color:#142c40;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif;font-size:28rpx;line-height:1.6}view,button,input{box-sizing:border-box}button::after{border:0}.page{padding:28rpx 24rpx 70rpx}.title{font-size:36rpx;line-height:1.5;font-weight:800;color:#004b8d}.muted{font-size:24rpx;color:#63798d;line-height:1.8;white-space:normal;overflow-wrap:anywhere}.card{background:#fff;border:1rpx solid #d8e6f0;border-radius:20rpx;padding:28rpx;margin-top:24rpx;min-width:0;overflow:hidden}.section-title{font-size:30rpx;font-weight:750;margin-bottom:18rpx}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20rpx}.field{min-width:0;margin-bottom:18rpx}.field text{display:block;font-size:25rpx;line-height:1.65;margin-bottom:8rpx}.field input,.picker{width:100%;height:84rpx;line-height:84rpx;border:1rpx solid #cddfeb;border-radius:12rpx;background:#fbfdff;padding:0 18rpx;font-size:28rpx;color:#173a56}.picker{height:auto;min-height:84rpx;line-height:1.6;padding:18rpx}.btn{width:100%;margin:18rpx 0 0;padding:21rpx 20rpx;background:#0068ad;color:#fff;font-size:28rpx;font-weight:700;line-height:1.6;min-height:82rpx;white-space:normal;overflow-wrap:anywhere;border-radius:14rpx}.btn.secondary{background:#edf6fc;color:#00558f;border:1rpx solid #cbdfea}.btn.danger{background:#fff4f4;color:#b94141;border:1rpx solid #efd3d3}.btn[disabled]{opacity:.5}.actions{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16rpx}.switch-row{display:flex;justify-content:space-between;gap:20rpx;align-items:center;margin:14rpx 0 22rpx}.switch-row text{flex:1;min-width:0}.switch-row switch{flex-shrink:0}.metric{padding:20rpx 0;border-bottom:1rpx solid #e5eef5}.metric:last-child{border:0}.metric-label{font-size:25rpx;color:#5c7285}.metric-value{font-size:43rpx;color:#004b8d;font-weight:800;line-height:1.6;overflow-wrap:anywhere}.link{font-size:24rpx;color:#0072bc;text-decoration:underline;display:inline-block;padding:12rpx 0}.note{border-left:5rpx solid #93bfdb;padding:12rpx 18rpx;margin-top:20rpx;font-size:24rpx;color:#526a7e;line-height:1.8}.warning{color:#a05b22;background:#fff8ed;padding:16rpx;border-radius:10rpx;margin-top:14rpx;font-size:25rpx}.row{display:flex;align-items:flex-start;justify-content:space-between;gap:20rpx;padding:14rpx 0;border-bottom:1rpx solid #edf2f6;line-height:1.7}.row .label{flex:1;min-width:0;color:#61778b;font-size:25rpx}.row .value{text-align:right;flex:0 1 52%;min-width:0;word-break:break-all;font-size:27rpx}.history-item{padding:22rpx 0;border-bottom:1rpx solid #dce7ef}.history-name{font-size:29rpx;font-weight:700;word-break:break-all}.history-number{font-weight:700;color:#ca3843;margin:8rpx 0}.pill{display:inline-block;font-size:22rpx;color:#406c8d;background:#edf5fb;padding:5rpx 10rpx;border-radius:8rpx;margin:6rpx 8rpx 0 0}.tabs{display:flex;gap:12rpx;margin:18rpx 0}.tabs .btn{flex:1;min-width:0;font-size:24rpx;padding:15rpx 8rpx}.tabs .active{background:#0068ad;color:white}.report-canvas{position:fixed;left:-3000px;top:0;width:750px;height:1100px;pointer-events:none}@media(max-width:360px){.grid{grid-template-columns:1fr}.metric-value{font-size:38rpx}.card{padding:22rpx}}
/* All alternatives are visible; radio groups remain mutually exclusive. */
.options{display:flex;flex-direction:column;gap:14rpx;margin:16rpx 0 24rpx}.option{display:flex;align-items:center;gap:12rpx;padding:18rpx 16rpx;border:2rpx solid #d9e5ee;border-radius:14rpx;background:#fff;font-size:26rpx;line-height:1.55;min-width:0}.option.checked{border-color:#0068ad;background:#f3faff;color:#004b8d;font-weight:600}.option radio{flex-shrink:0;transform:scale(.85)}.option text{min-width:0;flex:1;margin:0;overflow-wrap:anywhere}.inline-options{flex-direction:row;flex-wrap:wrap}.inline-options .option{flex:1 0 160rpx}.metric-value,.highlight,.row .value.highlight{color:#c93643}.highlight{font-weight:700}
